.pill{display:inline-block;padding:5px 14px;border:1px solid var(--ln);border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.25em;color:var(--mu)}
.st4{display:flex;justify-content:center;gap:34px;flex-wrap:wrap;margin:22px 0}.st4 b{display:block;font-size:34px;font-weight:900}.st4 span{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--mu);font-weight:700}
.hrow{display:grid;grid-template-columns:220px 1fr;gap:20px;text-align:left}.hrow img,.cov{width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:18px;border:1px solid var(--ln)}.cov{display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center;background:var(--pn);color:var(--mu)}
.hrow blockquote{margin:12px 0 0;font-size:clamp(18px,3vw,28px);font-weight:600;line-height:1.3;color:#fff}
@media(max-width:760px){.dgrid,.hrow{grid-template-columns:1fr}.hrow img,.cov{max-width:220px;margin:auto}nav{width:auto}.top{padding:12px}}
.frm{aspect-ratio:16/9;background:#0a0a0a;border-radius:12px;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:10px}.frm img{width:100%;height:100%;object-fit:cover}
.prog{height:4px;background:var(--ln);border-radius:4px;margin:0 18px 8px}.prog i{display:block;height:100%;background:linear-gradient(90deg,var(--ac),#f59e0b);border-radius:4px}
button,.card,input,textarea,select{transition:border-color .15s,background .15s,transform .15s}.proj:hover{transform:translateY(-2px);border-color:var(--ac)}
details.card>summary{list-style:none;padding:2px 0}details.card[open]>summary{margin-bottom:6px;border-bottom:1px solid var(--ln);padding-bottom:10px}
@media print{.hrow blockquote,.stat b,.st4 b{color:#000}}
</style>
