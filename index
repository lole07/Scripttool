nav button.on{background:var(--pn);box-shadow:inset 3px 0 var(--ac);font-weight:700}
nav .dot{color:var(--ok)}
main{flex:1;min-width:0;padding:18px 20px 80px;max-width:860px}
.tip{border-left:3px solid var(--ac);padding:6px 12px;margin:10px 0 16px;color:var(--mu);font-size:14px}
.opts{display:flex;gap:8px;flex-wrap:wrap}.opts button.on{background:var(--ac);color:#fff;border-color:var(--ac)}
