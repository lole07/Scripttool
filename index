return'<header class="top"><div class="logo" style="padding:0">🎞 STORY STUDIO</div><div><button data-a="imp">⬆ Importar backup</button><input type="file" id="imp" accept=".json" hidden></div></header><div class="wrap"><div class="dgrid"><div class="card"><h2>📈 Tu progreso narrativo</h2><p class="mu">Métricas de todo tu trabajo en Story Studio.</p><div class="g3">'+[[projects.length,'Proyectos',''],[esc,'Escenas','var(--ac)'],[fi,'Fichas','var(--ok)']].map(function(s){return'<div class="stat"><b style="color:'+(s[2]||'inherit')+'">'+s[0]+'</b><span>'+s[1]+'</span></div>'}).join('')+'</div></div><div class="card tipc"><div class="kick">📖 TIP DEL DÍA</div><p style="font-size:16px">“Un buen diálogo debe hacer dos cosas al mismo tiempo: avanzar la trama o revelar algo nuevo del personaje. Si no hace ninguna de las dos, bórralo.”</p></div></div><h2 style="font-size:26px;margin-bottom:16px">📂 Mis historias</h2><div class="grid"><button class="card newc" data-a="new"><span class="plus">+</span>Nuevo proyecto</button>'+list.map(function(p){var d=p.data||{};return'<div class="card proj" data-a="open" data-id="'+p.id+'"><div class="ico">🎬</div><h3>'+E(p.title||'Sin título')+'</h3><div class="mu">🕒 Modificado: '+new Date(p.lastModified).toLocaleDateString('es')+'</div>'+((d.genero&&d.genero.principal)?'<span class="chip">'+E(d.genero.principal)+'</span>':'<span class="chip" style="visibility:hidden">.</span>')+'<div class="row" style="margin-top:12px"><button data-a="exp" data-id="'+p.id+'">⬇ Respaldo</button><button class="dg" data-a="del" data-id="'+p.id+'">🗑</button></div></div>'}).join('')+'</div></div>'}
