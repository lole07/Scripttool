else if(tab==='personajes'){h='<h2>Personajes</h2>'+tip('El defecto fatal es la mentira que el personaje cree; el deseo es su objetivo; el arco es cómo cambia.')+ops(['Todos','Protagonista','Antagonista','Secundario','De apoyo'],rf,'rf')+'<div style="height:12px"></div>'+d.personajes.map(function(c,i){if(rf!=='Todos'&&c.role!==rf)return'';var b='personajes.'+i+'.';return'<details class="card" style="margin-bottom:12px"'+(i===0?' open':'')+'><summary class="ui" style="cursor:pointer;font-weight:700">'+E(c.name||'Personaje '+(i+1))+' <span class="mu">· '+c.role+'</span></summary>'+
'<div class="g2">'+'<div>'+lab('Nombre')+I(b+'name')+'</div><div>'+lab('Rol')+'<select data-p="'+b+'role">'+['Protagonista','Antagonista','Secundario','De apoyo'].map(function(r){return'<option'+(c.role===r?' selected':'')+'>'+r+'</option>'}).join('')+'</select></div></div>'+'<div class="g2"><div>'+lab('Profesión')+I(b+'job','Detective privado')+'</div><div>'+lab('Alineación moral')+I(b+'morality','Caótico bueno, cínico…')+'</div></div>'+lab('Edad y perfil')+I(b+'age','35 años, descuidado…')+lab('Virtud o talento')+I(b+'talent','En qué es excepcional')+
'<div class="g2"><div>'+lab('Deseo','desire',i)+T(b+'desire',PREG.desire[0],'ph-desire-'+(i+1))+'</div><div>'+lab('Impedimento','impediment',i)+T(b+'impediment',PREG.impediment[0],'ph-impediment-'+(i+1))+'</div><div>'+lab('Defecto fatal','flaw',i)+T(b+'flaw',PREG.flaw[0],'ph-flaw-'+(i+1))+'</div><div>'+lab('Mayor miedo','fears',i)+T(b+'fears',PREG.fears[0],'ph-fears-'+(i+1))+'</div></div>'+
lab('Máscaras míticas (arquetipos que usa en la historia)')+'<div class="opts">'+ARQ.map(function(x){return'<button class="'+(c.mit.indexOf(x)>=0?'on':'')+'" data-a="mit" data-i="'+i+'" data-v="'+x+'">'+x+'</button>'}).join('')+'</div>'+lab('Mapa de relaciones')+T(b+'rel','Para el protagonista es su mentor, pero en secreto es la sombra…')+lab('Curva de fortunas (+ triunfo, − pérdida)')+arc(c,i)+lab('Cambio interno')+T(b+'arc','¿Cómo es distinto al final?')+(d.personajes.length>1?'<button class="dg" style="margin-top:10px" data-a="delc" data-i="'+i+'">Eliminar personaje</button>':'')+'</details>'}).join('')+'<button data-a="addc">+ Añadir personaje</button>'}
else if(tab==='estructura'){h='<h2>Estructura en tres actos</h2>'+tip('Los puntos de giro son decisiones sin vuelta atrás.')+PUNTOS.map(function(p){return'<div class="pt" style="border-color:'+(g('estructura.'+p[0])?'var(--ok)':'var(--ln)')+'"><strong>'+p[1]+'</strong> <span class="mu">'+p[2]+' — '+p[3]+'</span>'+T('estructura.'+p[0],'¿Qué sucede aquí?')+'</div>'}).join('')}
else if(tab==='fichas'){h='<h2>Panel de fichas</h2>'+tip('Ordena los latidos de tu historia antes de la escaleta. Si te atascas, cambia el género o invierte al protagonista.')+'<div class="row" style="margin-bottom:14px"><button class="pr" data-a="addf">+ Ficha</button><button data-a="impf">Importar desde estructura</button><button data-a="tosc">Enviar a escaleta</button></div><div class="grid">'+d.fichas.map(function(f,i){var b='fichas.'+i+'.';return'<div class="ficha" style="background:'+COLS[f.c||0]+'"><input data-p="'+b+'t" value="'+E(f.t)+'" placeholder="Título del beat" style="font-weight:700"><textarea data-p="'+b+'d" placeholder="¿Qué ocurre?" style="margin-top:6px">'+E(f.d)+'</textarea><div class="row" style="margin-top:6px"><button data-a="mvf" data-i="'+i+'" data-d="-1" title="Mover antes">◀</button><button data-a="mvf" data-i="'+i+'" data-d="1" title="Mover después">▶</button><button data-a="colf" data-i="'+i+'">Color</button><button data-a="delf" data-i="'+i+'">✕</button></div></div>'}).join('')+'</div>'+(d.fichas.length?'':'<p class="mu">Tu muro está vacío. Añade fichas o impórtalas desde la estructura.</p>')}
else if(tab==='sinopsis'){h='<h2>Sinopsis</h2>'+tip('Tercera persona, presente, sin diálogos, y cuenta el final.')+T('sinopsis','Escribe la historia resumida…','',380)}
else if(tab==='escaleta'){h='<h2>Escaleta</h2>'+tip('Piensa cómo el final de una escena empuja la siguiente.')+d.escaleta.map(function(s,i){var b='escaleta.'+i+'.';return'<div class="card" style="margin-bottom:12px"><div class="sc"><strong>'+(i+1)+'</strong><div class="row" style="flex-wrap:nowrap"><select data-p="'+b+'tipo" style="width:90px">'+['INT.','EXT.','INT./EXT.'].map(function(x){return'<option'+(s.tipo===x?' selected':'')+'>'+x+'</option>'}).join('')+'</select><input data-p="'+b+'lugar" value="'+E(s.lugar)+'" placeholder="LUGAR"><select data-p="'+b+'tiempo" style="width:110px">'+['DÍA','NOCHE','AMANECER','ATARDECER'].map(function(x){return'<option'+(s.tiempo===x?' selected':'')+'>'+x+'</option>'}).join('')+'</select></div><div class="row" style="flex-wrap:nowrap"><button data-a="mvs" data-i="'+i+'" data-d="-1">↑</button><button data-a="mvs" data-i="'+i+'" data-d="1">↓</button><button class="dg" data-a="dels" data-i="'+i+'">✕</button></div></div>'+'<div class="g2"><div>'+T(b+'d','Acción y transición')+'</div><div>'+T(b+'dl','Diálogos o notas: de qué hablan')+'</div></div>'+'</div>'}).join('')+'<button class="pr" data-a="adds">+ Nueva escena</button>'}
else if(tab==='notas'){h='<h2>Bloc de notas</h2>'+tip('Feedback e ideas sueltas por aplicar.')+'<button class="pr" data-a="addn" style="margin-bottom:14px">+ Nota</button><div class="grid">'+d.notas.map(function(n,i){var b='notas.'+i+'.';return'<div class="card" style="border-top:4px solid '+NC[n.c||0]+'"><input data-p="'+b+'t" value="'+E(n.t)+'" placeholder="Título" style="font-weight:700">'+T(b+'d','Escribe aquí…')+'<button data-a="coln" data-i="'+i+'" style="margin:8px 6px 0 0">Color</button><button class="dg" data-a="deln" data-i="'+i+'" style="margin-top:8px">Eliminar</button></div>'}).join('')+'</div>'}
else if(tab==='maquina'){h='<h2>Desbloqueo creativo</h2>'+tip('Piensa en la escena que te atasca, tira de la palanca y pregúntate qué sugieren las tres frases.')+'<button class="pr" data-a="spin">Tirar</button><div class="grid" style="margin:16px 0">'+[0,1,2].map(function(i){return'<div class="card cardm">'+(cards[i]?'“'+E(cards[i])+'”':'<span class="mu">Esperando…</span>')+'</div>'}).join('')+'</div>'+lab('¿Cómo cambia esto tu historia?')+'<textarea id="interp" placeholder="Si la frase es “El escape es abrupto”, quizá mi protagonista no gane la pelea…">'+E(interp)+'</textarea><button style="margin-top:10px" data-a="savem">Guardar en notas</button>'}
else if(tab==='dossier'){var gn2=d.genero,pr=d.premisa;h='<div class="row noprint" style="justify-content:flex-end;margin-bottom:10px"><button data-a="print">Imprimir / PDF</button><button data-a="exp" data-id="'+cur.id+'">Respaldo .json</button></div><h3 style="margin-top:20px">Personajes</h3>'+d.personajes.filter(function(c){return c.name}).map(function(c){return'<div class="card" style="margin-bottom:10px"><strong>'+E(c.name)+'</strong> <span class="mu">'+c.role+'</span> '+c.mit.map(function(m){return'<span class="chip">'+m+'</span> '}).join('')+'<p>Deseo: '+E(c.desire||'—')+'<br>Impedimento: '+E(c.impediment||'—')+'</p>'+arc(c,-1)+'</div>'}).join('')+dosx()+'<h3 style="margin-top:20px">Estructura</h3>'+PUNTOS.filter(function(p){return d.estructura[p[0]]}).map(function(p){return'<p><strong>'+p[1]+':</strong> '+E(d.estructura[p[0]])+'</p>'}).join('')+(d.sinopsis?'<h3 style="margin-top:20px">Sinopsis</h3><p style="white-space:pre-wrap">'+E(d.sinopsis)+'</p>':'')+'<h3 style="margin-top:20px">Escaleta</h3>'+d.escaleta.map(function(s,i){return'<p><strong>'+(i+1)+'. '+s.tipo+' '+E(s.lugar)+' — '+s.tiempo+'</strong><br>'+E(s.d)+'</p>'}).join('')}
if(tab==='dossier')h=hero()+h;return h}

function arc(c,i){var n=c.arcGraph,W=300,pts=n.map(function(s,k){return(k*W/Math.max(1,n.length-1))+','+(50-s.v*15)}).join(' ');
var svg='<svg viewBox="-10 -5 320 110" style="width:100%;max-height:130px"><line x1="0" y1="50" x2="300" y2="50" stroke="var(--ln)" stroke-dasharray="4"/><polyline points="'+pts+'" fill="none" stroke="var(--ok)" stroke-width="3" stroke-linejoin="round"/>'+n.map(function(s,k){return'<circle cx="'+(k*W/Math.max(1,n.length-1))+'" cy="'+(50-s.v*15)+'" r="5" fill="var(--ok)"/>'}).join('')+'</svg>';
if(i<0)return svg;
return svg+'<div class="row" style="align-items:flex-start">'+n.map(function(s,k){return'<div class="card" style="padding:8px;width:130px"><input data-p="personajes.'+i+'.arcGraph.'+k+'.l" value="'+E(s.l)+'"><div class="row" style="justify-content:space-between;margin-top:6px"><button data-a="av" data-i="'+i+'" data-k="'+k+'" data-d="-1">−</button><strong>'+(s.v>0?'+'.repeat(s.v):s.v<0?'−'.repeat(-s.v):'0')+'</strong><button data-a="av" data-i="'+i+'" data-k="'+k+'" data-d="1">+</button></div><button class="dg mu" data-a="dela" data-i="'+i+'" data-k="'+k+'">quitar</button></div>'}).join('')+'<button data-a="adda" data-i="'+i+'">+ Etapa</button></div>'}

var selP='inicio',rf='Todos',dic=false,SC={sb:'',gu:''},frT='';
var ARQ=['Héroe','Mentor','Guardián del umbral','Heraldo','Figura cambiante','Sombra','Embaucador','Aliado'],ORI=['Un personaje','Lo biográfico','Noticias o leyendas','Explorar un género','Una trama universal'],VOZ=['Primera persona (yo)','Tercera persona limitada','Tercera persona omnisciente','Narrativa coral'],TIEMPO=['Lineal clásico','Lineal con grandes elipsis','No lineal (flashbacks)','Tiempo real'],IMP=['Identificador','De apoyo','Funcional','Estético','Metáfora','Generador de suspense','Generador de futuro narrativo','De descubrimiento','MacGuffin'],NC=['#f59e0b','#38bdf8','#34d399','#fb7185','#c084fc'];
var PLOTS=[['El Mesías','Alguien llega de fuera para ayudar a una comunidad en crisis. Ej: Shane, Superman.'],['Satán','Alguien llega de fuera a destruir la paz de una comunidad. Ej: Drácula, Alien.'],['El Vellocino de Oro','Un viaje en busca de un tesoro que lo cambiará todo. Ej: El Señor de los Anillos.'],['El Castillo','Una persona atrapada en una situación incomprensible y angustiosa. Ej: Cube, El hoyo.'],['Prometeo','Crear vida o tecnología que se descontrola. Ej: Frankenstein, Jurassic Park.'],['Orfeo','Caída progresiva hacia un infierno personal. Ej: Requiem for a Dream.']];
var PL=[['GPG','Gran plano general','Paisaje inmenso; da contexto de dónde estamos.'],['PG','Plano general','Sujeto de cuerpo entero y su entorno.'],['PE','Plano entero','De cabeza a pies; acción física completa.'],['PA','Plano americano','Corta por las rodillas; ideal para acción.'],['PM','Plano medio','Corta por la cintura; distancia de conversación.'],['PP','Primer plano','Hombros y rostro; emoción interna.'],['PPP','Primerísimo primer plano','Frente a barbilla; íntimo e intenso.'],['PD','Plano detalle','Un ojo, una mano; resalta algo crucial.']],AN=[['Normal','Altura de los ojos; neutro.'],['Picado','De arriba abajo; vulnerable.'],['Contrapicado','De abajo arriba; poderoso.'],['Cenital','Desde el techo; vista de pájaro.'],['Nadir','Desde el suelo hacia arriba.'],['Holandés','Cámara torcida; locura o caos.']],MV=[['Fija','Sin movimiento; foco en la composición.'],['Paneo','Gira en horizontal.'],['Tilt','Gira en vertical.'],['Dolly','La cámara viaja por el espacio.'],['Hombro','Vibración para realismo o tensión.']];
function ops(l,c,a){return'<div class="opts">'+l.map(function(x){return'<button class="'+(c===x?'on':'')+'" data-a="'+a+'" data-v="'+x+'">'+x+'</button>'}).join('')+'</div>'}
function sel(p,l,v){return'<select data-p="'+p+'">'+l.map(function(o){return'<option'+(o===v?' selected':'')+'>'+o+'</option>'}).join('')+'</select>'}
function ids(){cur.d.escaleta.forEach(function(s){if(!s.id)s.id=uid()})}
function sceneBar(k){var d=cur.d;ids();if(!d.escaleta.some(function(s){return s.id===SC[k]}))SC[k]=d.escaleta[0]?d.escaleta[0].id:'';return d.escaleta.length?lab('Escena')+'<select data-sc="'+k+'">'+d.escaleta.map(function(s,i){return'<option value="'+s.id+'"'+(s.id===SC[k]?' selected':'')+'>Escena '+(i+1)+': '+s.tipo+' '+E(s.lugar||'sin lugar')+'</option>'}).join('')+'</select>':'<div class="card"><p>Primero crea escenas en la Escaleta.</p><button class="pr" data-a="tab" data-t="escaleta">Ir a la escaleta</button></div>'}
function portadaV(){var d=cur.d;return'<h2>Portada y título</h2>'+tip('Un póster establece la atmósfera de tu historia. El título de trabajo debe ser corto y sugerente.')+lab('Título de la película')+I('titulo','Escribe tu título','style="font-size:26px;font-weight:800;text-align:center"')+lab('Portada')+'<div class="row" style="align-items:flex-start">'+(d.portada?'<img src="'+d.portada+'" alt="Portada" style="width:200px;border-radius:14px">':'<div class="cov" style="width:200px"><span>Sin portada</span></div>')+'<div><button data-a="cov">Subir imagen</button> '+(d.portada?'<button class="dg" data-a="rcov">Quitar</button>':'')+'<p class="mu">Se reduce automáticamente para ahorrar espacio.</p></div></div><input type="file" id="cov" accept="image/*" hidden>'}
function narr(){var n=cur.d.narrativa;return'<h2>Decisiones narrativas</h2>'+tip('La voz decide quién tiene la cámara; el tiempo marca el ritmo; los escenarios reflejan la psicología del personaje.')+lab('Voz narrativa')+ops(VOZ,n.voz,'nv')+lab('Arco temporal')+ops(TIEMPO,n.tiempo,'nt')+'<h3 style="margin-top:24px">Escenarios</h3>'+n.escenarios.map(function(x,i){var b='narrativa.escenarios.'+i+'.';return'<div class="card" style="margin-bottom:10px"><div class="g2">'+I(b+'n','Lugar (la cabaña)')+I(b+'a','Atmósfera (claustrofóbica, fría…)')+'</div>'+T(b+'d','Descripción visual')+'<button class="dg" data-a="dele" data-i="'+i+'" style="margin-top:8px">Eliminar</button></div>'}).join('')+'<button data-a="adde">+ Escenario</button><h3 style="margin-top:24px">Implantes (objetos clave)</h3>'+tip('Un implante es algo que plantas en la mente del espectador para usarlo luego. Chéjov: si en el primer acto hay un rifle en la pared, en el segundo o tercero debe dispararse.')+n.implantes.map(function(x,i){var b='narrativa.implantes.'+i+'.';return'<div class="card" style="margin-bottom:10px"><div class="g2">'+I(b+'n','Objeto (el maletín)')+sel(b+'t',IMP,x.t||IMP[0])+'</div>'+T(b+'d','¿Qué función cumple y cómo interactúan con él?')+'<button class="dg" data-a="deli" data-i="'+i+'" style="margin-top:8px">Eliminar</button></div>'}).join('')+'<button data-a="addi">+ Implante</button>'}
function espV(){return'<h2>El espectador</h2>'+tip('La clave de cualquier arte narrativo es lo que le pasa al público. Suspense: el público sabe más que el personaje (la bomba bajo la mesa). Sorpresa: sabe lo mismo o menos (la bomba explota de la nada).')+lab('Emoción objetivo: ¿qué debe sentir al terminar?')+I('espectador.emocion','Un alivio tenso…')+lab('Conexión empática: ¿por qué le importará tu protagonista en los primeros 10 minutos?')+T('espectador.empatia','Mi estrategia de empatía es…')+lab('Manejo de información: suspense y sorpresa')+T('espectador.info','Durante el segundo acto jugaré con el suspense revelando que…')}
function sbV(){var d=cur.d,bar=sceneBar('sb'),sc=d.escaleta.filter(function(x){return x.id===SC.sb})[0];return'<h2>Storyboard</h2>'+tip('Previsualiza la escena plano a plano. Si el personaje se siente aislado, usa un plano general; si oculta algo, un plano detalle de sus manos.')+bar+(sc?'<div class="card" style="margin:12px 0"><span class="mu">Acción de la escena:</span> '+E(sc.d||'Sin descripción')+'</div><div class="grid">'+d.storyboard.map(function(f,i){if(f.s!==SC.sb)return'';return'<div class="card"><div class="frm">'+(f.img?'<img src="'+f.img+'" alt="Viñeta">':'<span class="mu">16:9</span>')+'</div><textarea data-p="storyboard.'+i+'.d" placeholder="Ej: Primer plano de María sudando mientras mira la puerta…">'+E(f.d)+'</textarea><div class="row" style="margin-top:8px"><button data-a="frimg" data-id="'+f.id+'">Subir boceto</button><button class="dg" data-a="delfr" data-id="'+f.id+'">Eliminar</button></div></div>'}).join('')+'<button class="card newc" data-a="addfr" style="min-height:160px">+ Nueva viñeta</button></div><input type="file" id="fri" accept="image/*" hidden>':'')}
function dicV(){function c(t,l){return'<div class="card"><b>'+t+'</b>'+l.map(function(x){return'<p><b>'+x[0]+(x.length>2?' · '+x[1]:'')+'</b><br><span class="mu">'+x[x.length-1]+'</span></p>'}).join('')+'</div>'}return'<div class="grid" style="margin-bottom:14px">'+c('Tamaño',PL)+c('Ángulo',AN)+c('Movimiento',MV)+'</div>'}
function guV(){var d=cur.d,bar=sceneBar('gu'),sc=d.escaleta.filter(function(x){return x.id===SC.gu})[0],n=0;return'<h2>Guión técnico</h2>'+tip('Tu mundo es audiovisual. Sonido acusmático: se oye sin ver la fuente (genera misterio). Sonido diegético: viene de algo visible en escena. Anota recursos como cámara lenta o blanco y negro.')+bar+(sc?'<div class="row" style="margin:10px 0"><button data-a="dic">'+(dic?'Ocultar':'Ver')+' diccionario de planos</button></div>'+(dic?dicV():'')+d.guion.map(function(p,i){if(p.s!==SC.gu)return'';var b='guion.'+i+'.';n++;return'<div class="card" style="margin-bottom:10px"><div class="row" style="margin-bottom:8px"><b>Plano '+n+'</b><button data-a="mvpl" data-i="'+i+'" data-d="-1">↑</button><button data-a="mvpl" data-i="'+i+'" data-d="1">↓</button><button class="dg" data-a="delpl" data-i="'+i+'">✕</button></div><div class="g3" style="margin:0 0 8px">'+sel(b+'t',PL.map(function(x){return x[0]}),p.t)+sel(b+'a',AN.map(function(x){return x[0]}),p.a)+sel(b+'m',MV.map(function(x){return x[0]}),p.m)+'</div><div class="g2">'+T(b+'ac','¿Qué vemos? Efectos, cámara lenta…')+T(b+'au','Sonido, música, diálogos…')+'</div>'+I(b+'du','Duración (4 s)','style="margin-top:8px;max-width:160px"')+'</div>'}).join('')+'<button class="pr" data-a="addpl">+ Añadir plano</button>':'')}
function dosx(){var d=cur.d,e=d.espectador,n=d.narrativa;function f(a,b){return b?'<p><strong>'+a+':</strong> '+E(b)+'</p>':''}return'<h3 style="margin-top:20px">Espectador</h3>'+f('Emoción objetivo',e.emocion)+f('Empatía',e.empatia)+f('Información',e.info)+'<h3 style="margin-top:20px">Narrativa</h3>'+f('Voz',n.voz)+f('Tiempo',n.tiempo)+n.escenarios.map(function(x){return f(x.n||'Escenario',x.d+(x.a?' ('+x.a+')':''))}).join('')+n.implantes.map(function(x){return f(x.n||'Implante',(x.t||'')+': '+x.d)}).join('')}
function shrink(f,w,cb){var r=new FileReader();r.onload=function(){var im=new Image();im.onload=function(){var c=document.createElement('canvas'),s=Math.min(1,w/im.width);c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);cb(c.toDataURL('image/jpeg',.75))};im.src=r.result};r.readAsDataURL(f)}
function doFrame(e){var f=e.target.files[0];if(!f)return;shrink(f,480,function(u){cur.d.storyboard.forEach(function(x){if(x.id===frT)x.img=u});save();render()})}
function has(id){var d=cur.d;return{premisa:d.premisa.personaje,genero:d.genero.principal,personajes:d.personajes[0]&&d.personajes[0].name,estructura:d.estructura.inicio,fichas:d.fichas.length,sinopsis:d.sinopsis,escaleta:d.escaleta.length,notas:d.notas.length,portada:d.portada,narrativa:d.narrativa.voz,espectador:d.espectador.emocion,storyboard:d.storyboard.length,guion:d.guion.length}[id]}
function estr(){var d=cur.d,ic={inicio:'⚑',detonante:'⚡',giro1:'⇄',medio:'↗',giro2:'⚠',climax:'◎',resolucion:'✓'};var sel=PUNTOS.filter(function(p){return p[0]===selP})[0]||PUNTOS[0];
return'<h2>Estructura narrativa</h2>'+tip('Toca un punto de la línea para escribir qué sucede ahí. Los puntos de giro son decisiones sin vuelta atrás.')+'<div class="card"><div class="kick am">ESQUELETO NARRATIVO (3 ACTOS)</div><div class="tl">'+PUNTOS.map(function(p){var t=d.estructura[p[0]];return'<div class="nd" data-a="pt" data-v="'+p[0]+'"><span class="ci'+(t?' has':'')+(selP===p[0]?' sel':'')+'">'+ic[p[0]]+'</span><span class="bd">'+p[2].toUpperCase()+'</span><b>'+p[1]+'</b>'+(t?'<div class="sk">'+E(t)+'</div>':'')+'</div>'}).join('')+'</div><div style="border-top:1px solid var(--ln);margin-top:14px;padding-top:6px"><b>'+sel[1]+'</b> <span class="mu">'+sel[3]+'</span>'+T('estructura.'+sel[0],'¿Qué sucede en este punto de tu historia?','',130)+'</div></div>'}
function hero(){var d=cur.d,g2=d.genero,n=d.escaleta.filter(function(e){return e.lugar||e.d}).length;
return'<div class="hero"><span class="pill">DOCUMENTO DE DISEÑO NARRATIVO</span><h1>'+E(d.titulo)+'</h1>'+(g2.principal?'<p class="mu">'+E(g2.principal)+(g2.sub?' · '+E(g2.sub):'')+'</p>':'')+'<div class="st4">'+[[n,'Escenas'],[d.personajes.filter(function(c){return c.name}).length,'Personajes'],[d.fichas.length,'Beats'],['~'+n*2,'Min. aprox.']].map(function(s){return'<div><b>'+s[0]+'</b><span>'+s[1]+'</span></div>'}).join('')+'</div><div class="hrow">'+(d.portada?'<div><img src="'+d.portada+'" alt="Portada"><button class="noprint" data-a="rcov" style="margin-top:8px">Quitar portada</button></div>':'<div class="cov noprint"><span>Sin portada</span><button data-a="cov">Subir portada</button></div>')+'<div class="card"><div class="kick">💡 PREMISA</div><blockquote>“'+E(d.premisa.final||'Aún no definida.')+'”</blockquote></div></div><input type="file" id="cov" accept="image/*" hidden></div>'}
function doCover(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(){var im=new Image();im.onload=function(){var c=document.createElement('canvas'),s=Math.min(1,600/im.width);c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);cur.d.portada=c.toDataURL('image/jpeg',.8);save();render()};im.src=r.result};r.readAsDataURL(f)}
function render(){var y=window.scrollY;app.innerHTML=view==='dash'?dash():editor();var im=document.getElementById('imp');if(im)im.onchange=doImport;var cv=document.getElementById('cov');if(cv)cv.onchange=doCover;var fr=document.getElementById('fri');if(fr)fr.onchange=doFrame;window.scrollTo(0,y)}
function autoPremisa(){var p=cur.d.premisa,a=[];if(p.personaje)a.push(p.personaje);if(p.deseo)a.push('quiere '+p.deseo);if(p.impedimento)a.push('pero '+p.impedimento);p.final=a.join(', ')+(a.length?'.':'');var f=document.getElementById('final');if(f)f.value=p.final}
function doImport(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(){try{var o=JSON.parse(r.result);if(!o.data)throw 0;projects.push({id:uid(),title:o.title||'Importado',data:normalize(o.data),lastModified:Date.now()});persist();render();toast('Proyecto importado')}catch(x){toast('Ese archivo no es un respaldo de Story Studio')}};r.readAsText(f)}
function move(a,i,d){var j=i+d;if(j<0||j>=a.length)return;var t=a[i];a[i]=a[j];a[j]=t}
function go(fn){fn();save();render()}

app.addEventListener('input',function(e){var el=e.target,p=el.dataset.p;if(el.id==='interp'){interp=el.value;return}if(el.dataset.sc){SC[el.dataset.sc]=el.value;render();return}if(!p||!cur)return;setP(p,el.value);
if(p==='premisa.final'){cur.d.premisa.manual=el.value.trim()!==''}
else if(/^premisa\.(personaje|deseo|impedimento)$/.test(p)&&!cur.d.premisa.manual)autoPremisa();
later()});
app.addEventListener('click',function(e){var b=e.target.closest('[data-a]');if(!b)return;var a=b.dataset.a,i=+b.dataset.i,k=+b.dataset.k,d=+b.dataset.d,D=cur&&cur.d;
if(a==='new'){cur={id:uid(),d:empty()};view='ed';tab='premisa';save();render();return}
if(a==='imp'){document.getElementById('imp').click();return}
if(a==='open'){var p=projects.find(function(x){return x.id===b.dataset.id});if(p){cur={id:p.id,d:normalize(p.data)};view='ed';tab='premisa';render();scrollTo(0,0)}return}
if(a==='exp'){var q=projects.find(function(x){return x.id===b.dataset.id})||{id:cur.id,title:cur.d.titulo,data:cur.d};var l=document.createElement('a');l.href=URL.createObjectURL(new Blob([JSON.stringify(q)],{type:'application/json'}));l.download='StoryStudio_'+(q.title||'proyecto').replace(/[^a-z0-9]/gi,'_')+'.json';l.click();e.stopPropagation();return}
if(a==='del'){e.stopPropagation();if(confirm('¿Eliminar esta historia? No se puede deshacer. Descarga un respaldo antes si no estás seguro.')){projects=projects.filter(function(x){return x.id!==b.dataset.id});persist();render()}return}
if(a==='back'){clearTimeout(timer);save();view='dash';cur=null;render();return}
if(a==='tab'){tab=b.dataset.t;render();scrollTo(0,0);return}
if(a==='print'){window.print();return}
if(a==='dos'){tab='dossier';render();scrollTo(0,0);return}
if(a==='pt'){selP=b.dataset.v;render();return}if(a==='rf'){rf=b.dataset.v;render();return}if(a==='dic'){dic=!dic;render();return}if(a==='frimg'){frT=b.dataset.id;document.getElementById('fri').click();return}
if(a==='cov'){document.getElementById('cov').click();return}
if(a==='rcov'){cur.d.portada='';save();render();return}
if(a==='clr'){if(confirm('¿Limpiar todo el contenido de este proyecto?')){cur.d=empty();save();render()}return}
if(a==='delp'){if(confirm('¿Eliminar este proyecto de forma permanente?')){projects=projects.filter(function(x){return x.id!==cur.id});persist();cur=null;view='dash';render()}return}
if(a==='shuf'){var f=b.dataset.f,n=+b.dataset.i,el=document.getElementById('ph-'+f+'-'+n),o=PREG[f]||[];if(!el&&f)el=document.getElementById('ph-'+f+'-0');if(el)el.placeholder=o[Math.floor(Math.random()*o.length)];return}
if(a==='spin'){var s=0,t=setInterval(function(){cards=[0,1,2].map(function(){return FRASES[Math.floor(Math.random()*FRASES.length)]});if(++s>10){clearInterval(t);cards=FRASES.slice().sort(function(){return Math.random()-.5}).slice(0,3)}render()},90);return}
if(a==='savem'){if(!cards[0]||!interp.trim()){toast('Tira primero y escribe tu interpretación');return}go(function(){D.notas.push({t:'Desbloqueo '+new Date().toLocaleDateString('es'),d:cards.map(function(c){return'• '+c}).join('\n')+'\n\n'+interp});interp=''});toast('Guardado en notas');return}
go(function(){
if(a==='auto'){D.premisa.manual=false;autoPremisa()}
else if(a==='gen'){D.genero.principal=D.genero.principal===b.dataset.v?'':b.dataset.v}
else if(a==='sub'){D.genero.sub=D.genero.sub?D.genero.sub+', '+b.dataset.v:b.dataset.v}
else if(a==='addc')D.personajes.push(newChar());
else if(a==='delc'){if(confirm('¿Eliminar este personaje?'))D.personajes.splice(i,1)}
else if(a==='av'){var s=D.personajes[i].arcGraph[k];s.v=Math.max(-3,Math.min(3,s.v+d))}
else if(a==='adda')D.personajes[i].arcGraph.push({l:'Nueva etapa',v:0});
else if(a==='dela'){if(D.personajes[i].arcGraph.length>1)D.personajes[i].arcGraph.splice(k,1)}
else if(a==='addf')D.fichas.push({t:'',d:'',c:0});
else if(a==='delf')D.fichas.splice(i,1);
else if(a==='colf')D.fichas[i].c=((D.fichas[i].c||0)+1)%COLS.length;
else if(a==='mvf')move(D.fichas,i,d);
else if(a==='impf'){var c=0;PUNTOS.forEach(function(p,x){if(D.estructura[p[0]]){D.fichas.push({t:p[1],d:D.estructura[p[0]],c:x<3?0:x<5?1:2});c++}});toast(c?c+' fichas importadas':'Primero escribe algo en Estructura')}
else if(a==='tosc'){if(!D.fichas.length)toast('No hay fichas');else{D.fichas.forEach(function(f){D.escaleta.push({tipo:'INT.',lugar:(f.t||'').toUpperCase(),tiempo:'DÍA',d:f.d})});toast(D.fichas.length+' escenas creadas en la escaleta')}}
else if(a==='adds')D.escaleta.push({tipo:'INT.',lugar:'',tiempo:'DÍA',d:''});
else if(a==='dels')D.escaleta.splice(i,1);
else if(a==='mvs')move(D.escaleta,i,d);
else if(a==='addn')D.notas.push({t:'',d:''});
else if(a==='deln')D.notas.splice(i,1);
else if(a==='coln')D.notas[i].c=((D.notas[i].c||0)+1)%NC.length;
else if(a==='ori')D.premisa.origen=D.premisa.origen===b.dataset.v?'':b.dataset.v;
else if(a==='plot')D.premisa.trama=D.premisa.trama===b.dataset.v?'':b.dataset.v;
else if(a==='mit'){var m=D.personajes[i].mit,x=m.indexOf(b.dataset.v);if(x<0)m.push(b.dataset.v);else m.splice(x,1)}
else if(a==='nv')D.narrativa.voz=D.narrativa.voz===b.dataset.v?'':b.dataset.v;
else if(a==='nt')D.narrativa.tiempo=D.narrativa.tiempo===b.dataset.v?'':b.dataset.v;
else if(a==='adde')D.narrativa.escenarios.push({n:'',a:'',d:''});
else if(a==='dele')D.narrativa.escenarios.splice(i,1);
else if(a==='addi')D.narrativa.implantes.push({n:'',t:IMP[0],d:''});
else if(a==='deli')D.narrativa.implantes.splice(i,1);
else if(a==='addfr')D.storyboard.push({id:uid(),s:SC.sb,d:'',img:''});
else if(a==='delfr')D.storyboard=D.storyboard.filter(function(x){return x.id!==b.dataset.id});
else if(a==='addpl')D.guion.push({id:uid(),s:SC.gu,t:'PM',a:'Normal',m:'Fija',ac:'',au:'',du:''});
else if(a==='delpl')D.guion.splice(i,1);
else if(a==='mvpl'){var j=i+d;while(j>=0&&j<D.guion.length&&D.guion[j].s!==D.guion[i].s)j+=d;if(j>=0&&j<D.guion.length){var tt=D.guion[i];D.guion[i]=D.guion[j];D.guion[j]=tt}}
})});
