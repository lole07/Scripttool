.card{background:var(--pn);border:1px solid var(--ln);border-radius:12px;padding:16px}
.proj{cursor:pointer;min-height:120px}.proj:hover{border-color:var(--ac)}
.ed{display:flex;min-height:100vh}
nav{width:210px;flex:none;border-right:1px solid var(--ln);padding:14px 8px;position:sticky;top:0;height:100vh;overflow:auto}
