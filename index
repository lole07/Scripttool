.tl{display:flex;gap:18px;overflow-x:auto;padding:24px 4px 10px;align-items:flex-start}
.nd{flex:0 0 170px;display:flex;flex-direction:column;align-items:center;text-align:center;cursor:pointer;gap:8px}
.ci{width:48px;height:48px;border-radius:50%;border:2px solid #52525b;background:#0a0a0a;color:#a3a3a3;display:flex;align-items:center;justify-content:center;font-size:18px}.ci.has{border-color:#f59e0b;color:#f59e0b;box-shadow:0 0 14px #f59e0b33}.ci.sel{background:var(--ac);border-color:var(--ac);color:#fff}
.bd{font-size:9px;font-weight:800;letter-spacing:.14em;padding:3px 8px;background:rgba(255,255,255,.06);border-radius:5px;color:var(--mu)}
.sk{background:#0a0a0a;border-radius:14px;padding:12px;font-size:12px;text-align:left;white-space:pre-wrap;width:100%;max-height:260px;overflow:auto}
