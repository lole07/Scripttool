return'<div class="wrap"><div class="row" style="justify-content:space-between;margin-bottom:6px"><div><h1 style="font-size:30px">Story Studio</h1><div class="mu">Del primer chispazo a la escaleta, todo en un lugar.</div></div><div class="row"><button class="pr" data-a="new">Nuevo proyecto</button><button data-a="imp">Importar respaldo</button><input type="file" id="imp" accept=".json" hidden></div></div>'+
