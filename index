.ficha input,.ficha textarea{background:rgba(255,255,255,.55);border-color:rgba(0,0,0,.12);color:#222}
.sc{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center}
.cardm{min-height:100px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:17px;font-style:italic}
@media (max-width:760px){.ed{display:block}nav{width:auto;height:auto;position:sticky;z-index:5;background:var(--bg);display:flex;overflow-x:auto;border-right:0;border-bottom:1px solid var(--ln);padding:8px 6px;gap:4px}nav button{white-space:nowrap;width:auto;flex:none}nav .hide{display:none}.g2{grid-template-columns:1fr}main{padding:14px 12px 80px}}
@media print{nav,.noprint,.toast{display:none!important}.ed{display:block}body{background:#fff;color:#000}.card{border-color:#bbb;background:#fff}}
:root,:root:not([data-theme="light"]),:root[data-theme="dark"]{--bg:#0a0a0a;--pn:#141414;--tx:#e5e5e5;--mu:#8a8a8a;--ln:rgba(255,255,255,.09);--ac:#e11d48;--ok:#10b981;color-scheme:dark}
